# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: model used for the YES/NO decision calls (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: only needed if you connect this app to Inngest Cloud instead of
# running everything locally against the Inngest Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
