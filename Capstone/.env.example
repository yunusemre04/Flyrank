# Copy to .env (never commit .env). Free options only.
PROVIDER=gemini                 # gemini | ollama | mock (mock = offline test double, not for evidence)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBED_MODEL=all-minilm
DATABASE_URL=sqlite:///./app.db   # docker compose overrides this with Postgres
IMAGE_DIR=./data/images
CONFIDENCE_MIN=0.6
SIMILARITY_THRESHOLD=0.6        # tune: python -m scripts.eval --sweep
UNKNOWN_SUBJECT_MARGIN=0.05
TOP_K=5
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
REQUEST_DELAY=6                 # seconds between items; keeps you inside the free-tier rate limit
BUDGET_USD=1.0                  # list-price-equivalent cap; the job stops when reached
